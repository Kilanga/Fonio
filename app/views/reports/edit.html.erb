<!DOCTYPE html>
<html>
<head>
  <title><%= t("technician.report.title") %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
</head>
<body class="bg-slate-50">
  <div class="max-w-md mx-auto px-5 py-8">
    <h1 class="text-lg font-semibold mb-1"><%= t("technician.report.heading") %></h1>
    <p class="text-sm text-slate-500 mb-6">
      <%= t("technician.report.subheading", site_name: @call.intervention.site_name) %>
    </p>

    <%= form_with model: @call, url: report_path(token: @call.edit_token), method: :patch,
          local: true, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium mb-1"><%= t("technician.report.work_completed") %></label>
        <%= f.text_area :work_completed, rows: 3, class: "w-full border border-slate-300 rounded-md px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1"><%= t("technician.report.equipment_used") %></label>
        <%= f.text_area :equipment_used, rows: 2, class: "w-full border border-slate-300 rounded-md px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1"><%= t("technician.report.anomalies") %></label>
        <%= f.text_area :anomalies, rows: 2, class: "w-full border border-slate-300 rounded-md px-3 py-2" %>
      </div>
      <div class="flex items-center gap-2">
        <%= f.check_box :is_anomaly_severe %>
        <label class="text-sm"><%= t("technician.report.severe_anomaly") %></label>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1"><%= t("technician.report.recommendations") %></label>
        <%= f.text_area :recommendations, rows: 2, class: "w-full border border-slate-300 rounded-md px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1"><%= t("technician.report.duration") %></label>
        <%= f.number_field :actual_duration_minutes, class: "w-full border border-slate-300 rounded-md px-3 py-2" %>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1"><%= t("technician.report.photos") %></label>
        <%= f.file_field :photos, multiple: true, accept: "image/*", capture: "environment", class: "w-full text-sm" %>
        <p class="text-xs text-slate-400 mt-1"><%= t("technician.report.photos_hint") %></p>
      </div>

      <%= f.submit t("technician.report.submit"), class: "w-full bg-blue-600 text-white py-2.5 rounded-md text-sm font-medium" %>
    <% end %>
  </div>
</body>
</html>
