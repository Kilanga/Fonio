<!DOCTYPE html>
<html>
  <head>
    <title>Fonio — Field Intervention Tracker</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-900">
    <nav class="bg-white border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <%= link_to "Fonio", root_path, class: "font-semibold text-lg" %>
        <div class="flex gap-6 text-sm font-medium">
          <%= link_to "Pending", pending_interventions_path, class: "hover:text-blue-600" %>
          <%= link_to "In Progress", in_progress_interventions_path, class: "hover:text-blue-600" %>
          <%= link_to "Tracking", tracking_interventions_path, class: "hover:text-blue-600" %>
          <%= link_to "Dashboard", dashboard_path, class: "hover:text-blue-600" %>
          <%= link_to "Technicians", technicians_path, class: "hover:text-blue-600" %>
          <%= link_to "Audit Log", audit_logs_path, class: "hover:text-blue-600" %>
          <%= link_to "Technician login", technician_login_path, class: "hover:text-blue-600 text-slate-400" %>
        </div>
      </div>
    </nav>

    <main class="max-w-6xl mx-auto px-6 py-8">
      <% if notice %>
        <div class="mb-6 rounded-md bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="mb-6 rounded-md bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
