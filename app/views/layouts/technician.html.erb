<!DOCTYPE html>
<html dir="<%= technician_text_direction %>">
  <head>
    <title>Fonio — Technician</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <header class="bg-white border-b border-slate-200">
      <div class="max-w-md mx-auto px-5 py-3 flex items-center justify-between">
        <span class="font-semibold">Fonio</span>
        <%= form_with url: technician_locale_path, method: :patch, data: { controller: "locale-switcher" } do %>
          <label class="sr-only" for="locale-select"><%= t("technician.nav.language_label") %></label>
          <select id="locale-select" name="locale" data-action="change->locale-switcher#submit"
                  class="border border-slate-300 rounded-md px-2 py-1 text-sm bg-white">
            <% technician_locale_options.each do |label, code| %>
              <option value="<%= code %>" <%= "selected" if code == current_technician_locale %>><%= label %></option>
            <% end %>
          </select>
        <% end %>
      </div>
    </header>

    <main class="max-w-md mx-auto px-5 py-8">
      <% if notice %>
        <div class="mb-4 rounded-md bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="mb-4 rounded-md bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
