<!DOCTYPE html>
<html>
  <head>
    <title>Fonio — Technician</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-slate-50 text-slate-900">
    <main class="max-w-md mx-auto px-5 py-8">
      <% if notice %>
        <div class="mb-4 rounded-md bg-green-50 border border-green-200 text-green-800 px-4 py-3 text-sm"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="mb-4 rounded-md bg-red-50 border border-red-200 text-red-800 px-4 py-3 text-sm"><%= alert %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
