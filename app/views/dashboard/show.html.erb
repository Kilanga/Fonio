<h1 class="text-xl font-semibold mb-6">Dashboard</h1>

<div class="grid gap-4 md:grid-cols-3 mb-8">
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <p class="text-sm text-slate-500">Average resolution time</p>
    <p class="text-2xl font-semibold"><%= @avg_resolution_minutes ? "#{@avg_resolution_minutes} min" : "—" %></p>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <p class="text-sm text-slate-500">Severe anomaly rate</p>
    <p class="text-2xl font-semibold"><%= @anomaly_rate %>%</p>
    <p class="text-xs text-slate-400"><%= @severe_anomaly_count %> of <%= @total_reports %> reports</p>
  </div>
  <div class="bg-white border border-slate-200 rounded-lg p-4">
    <p class="text-sm text-slate-500">Total interventions</p>
    <p class="text-2xl font-semibold"><%= @status_counts.values.sum %></p>
  </div>
</div>

<div class="bg-white border border-slate-200 rounded-lg p-4 mb-6">
  <p class="font-medium mb-3">By status</p>
  <ul class="space-y-2">
    <% @status_counts.each do |status, count| %>
      <li class="flex justify-between text-sm">
        <span><%= status.humanize %></span>
        <span class="font-medium"><%= count %></span>
      </li>
    <% end %>
  </ul>
</div>

<div class="bg-white border border-slate-200 rounded-lg p-4">
  <p class="font-medium mb-1">Trigger PM recap call now</p>
  <p class="text-xs text-slate-500 mb-3">
    Skips the noon/6pm schedule (and the "nothing to report" check) — useful for demos.
  </p>
  <div class="flex gap-2">
    <%= button_to "Trigger morning recap", dashboard_trigger_daily_summary_path(period: "morning"), method: :post,
          form: { data: { controller: "submit-once", action: "submit->submit-once#submitting" } },
          class: "bg-slate-900 text-white text-sm px-3 py-2 rounded-md" %>
    <%= button_to "Trigger afternoon recap", dashboard_trigger_daily_summary_path(period: "afternoon"), method: :post,
          form: { data: { controller: "submit-once", action: "submit->submit-once#submitting" } },
          class: "bg-slate-900 text-white text-sm px-3 py-2 rounded-md" %>
  </div>
</div>
