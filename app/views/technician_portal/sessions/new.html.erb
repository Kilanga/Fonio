<h1 class="text-xl font-semibold mb-6 text-center"><%= t("technician.login.title") %></h1>

<div class="bg-white border border-slate-200 rounded-lg p-4 mb-4">
  <%= form_with url: technician_login_path, method: :post, class: "space-y-3" do %>
    <div>
      <label class="block text-sm font-medium mb-1"><%= t("technician.login.phone_number") %></label>
      <input type="tel" name="phone" placeholder="+33..." required autocomplete="tel"
             class="w-full border border-slate-300 rounded-md px-3 py-2 text-base">
    </div>
    <div>
      <label class="block text-sm font-medium mb-1"><%= t("technician.login.password") %></label>
      <input type="password" name="password" required autocomplete="current-password"
             class="w-full border border-slate-300 rounded-md px-3 py-2 text-base">
    </div>

    <button type="submit" class="w-full bg-blue-600 text-white py-2.5 rounded-md text-sm font-medium mt-3"><%= t("technician.login.submit") %></button>
  <% end %>
</div>
