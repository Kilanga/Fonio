<div class="flex justify-between items-center mb-6">
  <h1 class="text-xl font-semibold"><%= t("technician.interventions.greeting", name: current_technician.name) %></h1>
  <%= button_to t("technician.interventions.log_out"), technician_logout_path, method: :delete, class: "text-sm text-slate-400" %>
</div>

<h2 class="text-sm font-medium text-slate-500 mb-2"><%= t("technician.interventions.heading") %></h2>

<% if @pending.empty? && @in_progress.empty? %>
  <p class="text-slate-500 text-sm"><%= t("technician.interventions.empty") %></p>
<% end %>

<% @in_progress.each do |intervention| %>
  <%= link_to technician_intervention_path(intervention), class: "block bg-white border border-slate-200 rounded-lg p-4 mb-3" do %>
    <p class="font-semibold"><%= intervention.site_name %></p>
    <p class="text-sm text-blue-600 mt-1"><%= t("technician.interventions.in_progress") %></p>
    <% if intervention.reminder_sent_at? %>
      <p class="text-sm text-amber-700 mt-1"><%= t("technician.interventions.overdue_notice") %></p>
    <% end %>
  <% end %>
<% end %>

<% @pending.each do |intervention| %>
  <%= link_to technician_intervention_path(intervention), class: "block bg-white border border-slate-200 rounded-lg p-4 mb-3" do %>
    <p class="font-semibold"><%= intervention.site_name %></p>
    <p class="text-sm text-slate-500"><%= intervention.scheduled_at.strftime("%b %-d, %H:%M") %></p>
    <% if intervention.accepted_at? %>
      <p class="text-sm text-green-700 mt-1"><%= t("technician.interventions.accepted") %></p>
    <% else %>
      <p class="text-sm text-amber-700 mt-1"><%= t("technician.interventions.awaiting_acceptance") %></p>
    <% end %>
  <% end %>
<% end %>

<%= turbo_stream_from "technician_pool" %>
<%= render "available_pool", available: @available %>

<% if @others.present? %>
  <h2 class="text-sm font-medium text-slate-500 mb-2 mt-6"><%= t("technician.interventions.others_heading") %></h2>
  <% @others.each do |intervention| %>
    <div class="bg-slate-100 border border-slate-200 rounded-lg p-4 mb-3 opacity-70">
      <p class="font-semibold text-slate-600"><%= intervention.site_name %></p>
      <p class="text-sm text-slate-500"><%= t("technician.interventions.taken_by", name: intervention.technician.name) %></p>
    </div>
  <% end %>
<% end %>
