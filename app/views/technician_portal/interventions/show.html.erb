<%= link_to t("technician.interventions.back"), technician_interventions_path, class: "text-sm text-blue-600 hover:underline" %>

<h1 class="text-xl font-semibold mt-3 mb-1"><%= @intervention.site_name %></h1>
<p class="text-sm text-slate-500 mb-6"><%= @intervention.site_address %></p>

<div class="bg-white border border-slate-200 rounded-lg p-4 mb-4">
  <p class="text-sm text-slate-500"><%= t("technician.interventions.scheduled") %></p>
  <p class="font-medium"><%= @intervention.scheduled_at.strftime("%b %-d, %H:%M") %></p>
</div>

<% if @intervention.in_progress? %>
  <p class="text-blue-700 text-sm font-medium"><%= t("technician.interventions.in_progress_notice") %></p>
<% elsif !@intervention.accepted_at? %>
  <%= button_to t("technician.interventions.accept_button"), accept_technician_intervention_path(@intervention), method: :post,
        class: "w-full bg-blue-600 text-white py-2.5 rounded-md text-sm font-medium" %>
<% else %>
  <p class="text-sm text-green-700 mb-3"><%= t("technician.interventions.accepted_notice") %></p>
  <%= button_to t("technician.interventions.start_button"), start_intervention_technician_intervention_path(@intervention), method: :post,
        class: "w-full bg-slate-900 text-white py-2.5 rounded-md text-sm font-medium" %>
<% end %>
