<%= link_to "← Back", technician_interventions_path, class: "text-sm text-blue-600 hover:underline" %>

<h1 class="text-xl font-semibold mt-3 mb-1"><%= @intervention.site_name %></h1>
<p class="text-sm text-slate-500 mb-6"><%= @intervention.site_address %></p>

<div class="bg-white border border-slate-200 rounded-lg p-4 mb-4">
  <p class="text-sm text-slate-500">Scheduled</p>
  <p class="font-medium"><%= @intervention.scheduled_at.strftime("%b %-d, %H:%M") %></p>
</div>

<% if @intervention.in_progress? %>
  <p class="text-blue-700 text-sm font-medium">This intervention is in progress. We'll check in with you by phone 30 minutes after you started.</p>
<% elsif !@intervention.accepted_at? %>
  <%= button_to "Accept this intervention", accept_technician_intervention_path(@intervention), method: :post,
        class: "w-full bg-blue-600 text-white py-2.5 rounded-md text-sm font-medium" %>
<% else %>
  <p class="text-sm text-green-700 mb-3">Accepted. Tap below once you're on site and starting.</p>
  <%= button_to "I've started", start_intervention_technician_intervention_path(@intervention), method: :post,
        class: "w-full bg-slate-900 text-white py-2.5 rounded-md text-sm font-medium" %>
<% end %>
