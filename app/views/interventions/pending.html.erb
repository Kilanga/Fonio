<div class="flex justify-between items-center mb-6">
  <h1 class="text-xl font-semibold">Pending Interventions</h1>
  <%= link_to "+ Schedule intervention", new_intervention_path, class: "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700" %>
</div>

<% if @interventions.empty? %>
  <p class="text-slate-500 text-sm">No interventions scheduled yet.</p>
<% else %>
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    <% @interventions.each do |intervention| %>
      <div class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
        <p class="font-semibold"><%= intervention.site_name %></p>
        <p class="text-sm text-slate-500">
          <%= intervention.technician&.name || "Unassigned" %>
        </p>
        <p class="text-sm text-slate-500 mt-1">Scheduled: <%= intervention.scheduled_at.strftime("%b %-d, %H:%M") %></p>
        <% if intervention.technician.nil? %>
          <p class="mt-3 text-sm text-amber-700">Open to any technician to claim</p>
        <% elsif intervention.accepted_at? %>
          <p class="mt-3 text-sm text-green-700">Accepted by <%= intervention.technician.name %> — awaiting them to start</p>
        <% else %>
          <p class="mt-3 text-sm text-amber-700">Awaiting technician acceptance</p>
        <% end %>
        <%= button_to "Cancel", cancel_intervention_path(intervention), method: :post,
              form: { data: { turbo_confirm: "Cancel this intervention?" } },
              class: "mt-2 w-full bg-white border border-red-300 text-red-600 text-sm font-medium py-2 rounded-md hover:bg-red-50" %>
      </div>
    <% end %>
  </div>
<% end %>
