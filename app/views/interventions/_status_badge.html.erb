<%
  colors = {
    "pending" => "bg-slate-100 text-slate-700",
    "in_progress" => "bg-blue-100 text-blue-700",
    "no_show" => "bg-gray-200 text-gray-700",
    "closing_in_progress" => "bg-indigo-100 text-indigo-700",
    "action_required" => "bg-amber-100 text-amber-800",
    "completed" => "bg-green-100 text-green-700",
    "call_failed" => "bg-gray-300 text-gray-800",
    "cancelled" => "bg-slate-200 text-slate-600"
  }
%>
<span class="inline-block px-2 py-1 rounded text-xs font-medium <%= colors[intervention.status] %>">
  <%= intervention.status.humanize %>
</span>
