<%= turbo_frame_tag "intervention_#{intervention.id}" do %>
  <div id="intervention_<%= intervention.id %>" class="bg-white border border-slate-200 rounded-lg p-4 shadow-sm">
    <div class="flex justify-between items-start">
      <div>
        <p class="font-semibold"><%= intervention.site_name %></p>
        <p class="text-sm text-slate-500">
          <% if intervention.technician %>
            <%= intervention.technician.name %> · <%= masked_phone(intervention.technician.phone) %>
          <% else %>
            <span class="text-amber-700">Unassigned — open to any technician</span>
          <% end %>
        </p>
      </div>
      <%= render "interventions/status_badge", intervention: intervention %>
    </div>

    <div class="mt-3 text-sm text-slate-600 space-y-1">
      <% if intervention.started_at %>
        <p>Started: <%= intervention.started_at.strftime("%b %-d, %H:%M") %></p>
      <% end %>
      <% if intervention.reminder_sent_at %>
        <p class="text-slate-400">Reminder sent <%= time_ago_in_words(intervention.reminder_sent_at) %> ago</p>
      <% end %>
      <% latest_check_in = intervention.calls.select { |c| c.call_type == "check_in" }.max_by(&:attempt) %>
      <% if latest_check_in&.has_issue? %>
        <p class="text-amber-700">
          Issue: <%= latest_check_in.issue_type&.humanize || "unspecified" %>
          (<%= latest_check_in.severity %>) — needs help: <%= latest_check_in.needs_help ? "yes" : "no" %>
        </p>
        <% if latest_check_in.help_needed_description.present? %>
          <p class="text-amber-700">"<%= latest_check_in.help_needed_description %>"</p>
        <% end %>
      <% end %>
    </div>

    <div class="mt-4 flex gap-2">
      <%= link_to "Details", intervention_path(intervention), class: "text-sm text-blue-600 hover:underline" %>
      <% if intervention.status.in?(%w[action_required call_failed no_show]) %>
        <%= button_to "Mark resolved", resolve_intervention_path(intervention), method: :post, class: "text-sm text-slate-500 hover:underline" %>
      <% end %>
      <% if intervention.in_progress? && intervention.calls.empty? %>
        <%= button_to "Cancel", cancel_intervention_path(intervention), method: :post,
              form: { data: { turbo_confirm: "Cancel this intervention? No check-in or closing call will be placed." } },
              class: "text-sm text-red-600 hover:underline" %>
      <% end %>
    </div>
  </div>
<% end %>
