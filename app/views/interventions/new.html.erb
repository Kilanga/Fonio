<h1 class="text-xl font-semibold mb-6">Schedule an intervention</h1>

<% if @technicians.empty? %>
  <p class="text-amber-700 text-sm">No consented technicians yet — add one first.</p>
  <%= link_to "Add a technician", new_technician_path, class: "text-blue-600 hover:underline text-sm" %>
<% else %>
  <%= form_with model: @intervention, class: "max-w-lg space-y-4" do |f| %>
    <div>
      <label class="block text-sm font-medium mb-1">Technician</label>
      <%= f.collection_select :technician_id, @technicians, :id, :name, {}, class: "w-full border border-slate-300 rounded-md px-3 py-2" %>
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Site name</label>
      <%= f.text_field :site_name, class: "w-full border border-slate-300 rounded-md px-3 py-2" %>
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Site address</label>
      <%= f.text_field :site_address, class: "w-full border border-slate-300 rounded-md px-3 py-2" %>
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Scheduled at</label>
      <%= f.datetime_field :scheduled_at, class: "w-full border border-slate-300 rounded-md px-3 py-2" %>
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Expected end time (optional, enables overdue reminder)</label>
      <%= f.datetime_field :expected_end_time, class: "w-full border border-slate-300 rounded-md px-3 py-2" %>
    </div>
    <%= f.submit "Schedule", class: "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700" %>
  <% end %>
<% end %>
