<h1 class="text-xl font-semibold mb-6">Add a technician</h1>

<%= form_with model: @technician, class: "max-w-lg space-y-4" do |f| %>
  <div>
    <label class="block text-sm font-medium mb-1">Name</label>
    <%= f.text_field :name, class: "w-full border border-slate-300 rounded-md px-3 py-2" %>
  </div>
  <div>
    <label class="block text-sm font-medium mb-1">Phone (with country code)</label>
    <%= f.text_field :phone, placeholder: "+33...", class: "w-full border border-slate-300 rounded-md px-3 py-2" %>
  </div>

  <div class="bg-blue-50 border border-blue-200 rounded-md p-3 text-sm text-blue-800">
    After saving, the technician gets a text with a link to set up their own
    account. Setting a password is their own consent to receive AI-initiated
    calls/texts — no call is placed until they've done that. They'll also
    choose and confirm their own preferred call region/language, every time
    they log in.
  </div>

  <%= f.submit "Save technician", class: "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700" %>
<% end %>
