<div class="flex justify-between items-center mb-6">
  <h1 class="text-xl font-semibold">Technicians</h1>
  <%= link_to "+ Add technician", new_technician_path, class: "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700" %>
</div>

<div class="space-y-3">
  <% @technicians.each do |technician| %>
    <div class="bg-white border border-slate-200 rounded-lg p-4 flex justify-between items-center">
      <div>
        <p class="font-semibold"><%= technician.name %></p>
        <p class="text-sm text-slate-500"><%= masked_phone(technician.phone) %></p>
        <% if technician.activated? %>
          <p class="text-xs text-slate-400">Region/language: <%= technician.region || "not set yet" %> / <%= technician.locale || "not set yet" %></p>
        <% end %>
      </div>
      <% if technician.activated? %>
        <span class="text-sm text-green-700">Active — consent given <%= technician.consent_given_at.strftime("%b %-d, %Y") %></span>
      <% elsif technician.activation_token_valid? %>
        <div class="text-right">
          <span class="text-sm text-amber-700 block mb-1">Awaiting activation</span>
          <input readonly onclick="this.select()" value="<%= technician_activation_url(token: technician.activation_token, host: default_host) %>"
                 class="text-xs border border-slate-200 rounded px-2 py-1 w-64 text-slate-500">
        </div>
      <% else %>
        <span class="text-sm text-slate-400">Activation link expired</span>
      <% end %>
    </div>
  <% end %>
</div>
