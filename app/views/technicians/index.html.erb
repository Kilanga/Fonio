<div class="flex justify-between items-center mb-6">
  <h1 class="text-xl font-semibold">Technicians</h1>
  <%= link_to "+ Add technician", new_technician_path, class: "bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700" %>
</div>

<div class="space-y-3">
  <% @technicians.each do |technician| %>
    <div class="bg-white border border-slate-200 rounded-lg p-4 flex justify-between items-center">
      <div>
        <p class="font-semibold"><%= technician.name %></p>
        <p class="text-sm text-slate-500"><%= technician.phone %></p>
      </div>
      <% if technician.consent_given? %>
        <span class="text-sm text-green-700">Consent confirmed <%= technician.consent_given_at.strftime("%b %-d, %Y") %></span>
      <% else %>
        <div class="text-right">
          <p class="text-sm text-amber-700 mb-2">Consent not yet confirmed — cannot be called</p>
          <%= button_to "Confirm consent", consent_technician_path(technician), method: :post,
                class: "text-sm bg-slate-900 text-white px-3 py-1.5 rounded-md" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
